{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "QEMU: start debugger",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/vscode.ps1", "-Action", "Start"],
      "problemMatcher": []
    },
    {
      "label": "QEMU: stop debugger",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/vscode.ps1", "-Action", "Stop"],
      "problemMatcher": []
    },
    {
      "label": "Собрать ESP32",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Запустить QEMU с мышью",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/run.ps1"],
      "problemMatcher": []
    }
  ]
}
